# ==============================================================================
# FORA AI - Autonomous Multi-Agent Research Engine & Runtime Security Control Plane
# Environment Configuration Template
# ==============================================================================

# LLM Provider: "groq" or "ollama"
LLM_PROVIDER=groq

# Groq API Configuration (Free tier: https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
DEFAULT_MODEL=qwen/qwen3.8-27b

# Ollama Local Configuration (Used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Research Engine Limits & Timeouts
MAX_RESEARCH_ITERATIONS=3
SEARCH_MAX_RESULTS=5
REQUEST_TIMEOUT_SECONDS=30

# State Persistence
SQLITE_DB_PATH=checkpoints.db

# API & Server Configuration
API_PORT=8000
API_HOST=0.0.0.0
CORS_ORIGINS=["*"]
LOG_LEVEL=INFO
